# ── PostgreSQL ────────────────────────────────────────────────────────────
# Option 1: Direct Connection URL (recommended for Neon, Supabase, Cloud Postgres)
# DATABASE_URL=postgresql://user:password@ep-example.neon.tech/neondb?sslmode=require

# Option 2: Individual Connection Parameters (for local Postgres)
POSTGRES_USER=gakondo
POSTGRES_PASSWORD=gakondo
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gakondo_vision
# POSTGRES_SSLMODE=require

# ── CLIP Model ────────────────────────────────────────────────────────────
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
EMBEDDING_DIM=512

# ── Chunking ──────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ── Retrieval ─────────────────────────────────────────────────────────────
TOP_K=5

# ── FastAPI ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Streamlit ─────────────────────────────────────────────────────────────
STREAMLIT_PORT=8501
